@page
@model HealthDataGateway.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-circle"></i> Sign in</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" id="loginForm">
                        <input type="hidden" asp-for="RequestedRole" />

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Username</label>
                            <input asp-for="Username" class="form-control form-control-lg" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div id="loginError" class="alert alert-danger d-none"></div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg">Sign in</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
            const form = document.getElementById('loginForm');
            const errorBox = document.getElementById('loginError');

            form.addEventListener('submit', async function(e){
                // If the form was opened from modal it might be intended for AJAX. We'll use AJAX when header X-Requested-With is supported by fetch.
                // prevent default only for AJAX case
                const isAjax = true;
                if (!isAjax) return;

                e.preventDefault();

                const data = new FormData(form);
                const resp = await fetch(form.action || window.location.pathname, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: data
                });

                const json = await resp.json();
                if (!json.success) {
                    errorBox.classList.remove('d-none');
                    errorBox.innerText = json.message || 'Login failed';
                    return;
                }

                // Success - redirect
                window.location.href = json.redirectUrl || '/';
            });
        })();
    </script>
}
