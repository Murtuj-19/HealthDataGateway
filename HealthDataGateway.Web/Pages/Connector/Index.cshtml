@page
@model HealthDataGateway.Web.Pages.Connector.IndexModel
@{
    ViewData["Title"] = "Connector Gateway Dashboard";
}

<style>
    .connector-badge-success {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

    .table-status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .btn-deliver {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        border: none;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-deliver:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(67, 233, 123, 0.3);
        color: white;
    }
</style>

<div class="container-fluid fade-in">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);">
                <div class="card-body text-white p-4">
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="bi bi-gear-wide-connected"></i> Connector Gateway Dashboard
                    </h1>
                    <p class="lead mb-0">
                        <i class="bi bi-shield-lock"></i> Secure Data Exchange Middleware - AES-256 Encrypted
                    </p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 cursor-pointer" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 12px 25px rgba(245, 87, 108, 0.3)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.1)'">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75 mb-2">
                                <i class="bi bi-hourglass-split"></i> Processing
                            </h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.ProcessingCount</h2>
                        </div>
                        <i class="bi bi-hourglass-split opacity-50" style="font-size: 4rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 cursor-pointer connector-badge-success" style="transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 12px 25px rgba(67, 233, 123, 0.3)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.1)'">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75 mb-2">
                                <i class="bi bi-check-circle"></i> Delivered
                            </h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.DeliveredCount</h2>
                        </div>
                        <i class="bi bi-check-circle-fill opacity-50" style="font-size: 4rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100 cursor-pointer" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 12px 25px rgba(250, 112, 154, 0.3)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.1)'">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75 mb-2">
                                <i class="bi bi-x-circle"></i> Failed
                            </h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.FailedCount</h2>
                        </div>
                        <i class="bi bi-x-circle-fill opacity-50" style="font-size: 4rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul"></i> All Connector Requests
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.ConnectorRequests.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
                            <p class="text-muted mt-3 fs-5">No connector requests</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th><i class="bi bi-hash"></i> ID</th>
                                        <th><i class="bi bi-person"></i> Patient</th>
                                        <th><i class="bi bi-building"></i> Source</th>
                                        <th><i class="bi bi-building"></i> Target</th>
                                        <th><i class="bi bi-lock"></i> Encryption</th>
                                        <th><i class="bi bi-file-medical"></i> FHIR</th>
                                        <th><i class="bi bi-activity"></i> Status</th>
                                        <th><i class="bi bi-clock"></i> Created</th>
                                        <th><i class="bi bi-gear"></i> Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.ConnectorRequests)
                                    {
                                        <tr>
                                            <td><strong>#@request.ConnectorRequestId</strong></td>
                                            <td>
                                                <span class="fw-semibold">@request.TransferRequest.Patient.FullName</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-house"></i> @request.TransferRequest.SourceHospital.HospitalName
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-house-fill"></i> @request.TransferRequest.TargetHospital.HospitalName
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="bi bi-shield-lock"></i> @request.EncryptionType
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (request.IsFHIRCompliant)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle-fill"></i> Yes
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-x-circle-fill"></i> No
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (request.Status == "PROCESSING")
                                                {
                                                    <span class="badge table-status-badge" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                                                        <i class="bi bi-hourglass-split"></i> PROCESSING
                                                    </span>
                                                }
                                                else if (request.Status == "DELIVERED")
                                                {
                                                    <span class="badge table-status-badge" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
                                                        <i class="bi bi-check-circle-fill"></i> DELIVERED
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge table-status-badge" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: #333;">
                                                        <i class="bi bi-x-circle-fill"></i> FAILED
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@request.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                            </td>
                                            <td>
                                                @if (request.Status == "PROCESSING")
                                                {
                                                    <form method="post" asp-page-handler="Deliver" class="d-inline">
                                                        <input type="hidden" name="connectorRequestId" value="@request.ConnectorRequestId" />
                                                        <input type="hidden" name="targetHospitalId" value="@request.TransferRequest.TargetHospitalId" />
                                                        <button type="submit" class="btn btn-sm btn-deliver"
                                                                onclick="return confirm('Deliver this encrypted request to target hospital?')">
                                                            <i class="bi bi-send-fill"></i> Deliver
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
