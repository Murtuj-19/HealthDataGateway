@page
@model HealthDataGateway.Web.Pages.Connector.IndexModel
@{
    ViewData["Title"] = "Connector Gateway Dashboard";
}

<div class="container-fluid fade-in">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);">
                <div class="card-body text-white p-4">
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="bi bi-gear-wide-connected"></i> Connector Gateway Dashboard
                    </h1>
                    <p class="lead mb-0">Secure Data Exchange Middleware</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75">Processing</h6>
                            <h2 class="display-3 fw-bold">@Model.ProcessingCount</h2>
                        </div>
                        <i class="bi bi-hourglass-split opacity-50" style="font-size: 5rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75">Delivered</h6>
                            <h2 class="display-3 fw-bold">@Model.DeliveredCount</h2>
                        </div>
                        <i class="bi bi-check-circle-fill opacity-50" style="font-size: 5rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75">Failed</h6>
                            <h2 class="display-3 fw-bold">@Model.FailedCount</h2>
                        </div>
                        <i class="bi bi-x-circle-fill opacity-50" style="font-size: 5rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul"></i> All Connector Requests
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.ConnectorRequests.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
                            <p class="text-muted mt-3 fs-5">No connector requests</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Patient</th>
                                        <th>Source</th>
                                        <th>Target</th>
                                        <th>Encryption</th>
                                        <th>FHIR</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.ConnectorRequests)
                                    {
                                        <tr>
                                            <td><strong>#@request.ConnectorRequestId</strong></td>
                                            <td>@request.TransferRequest.Patient.FullName</td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @request.TransferRequest.SourceHospital.HospitalName
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">
                                                    @request.TransferRequest.TargetHospital.HospitalName
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">@request.EncryptionType</span>
                                            </td>
                                            <td class="text-center">
                                                @if (request.IsFHIRCompliant)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                                                }
                                            </td>
                                            <td>
                                                @if (request.Status == "PROCESSING")
                                                {
                                                    <span class="badge bg-warning">PROCESSING</span>
                                                }
                                                else if (request.Status == "DELIVERED")
                                                {
                                                    <span class="badge bg-success">DELIVERED</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">FAILED</span>
                                                }
                                            </td>
                                            <td>
                                                <small>@request.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                            </td>
                                            <td>
                                                @if (request.Status == "PROCESSING")
                                                {
                                                    <form method="post" asp-page-handler="Deliver" class="d-inline">
                                                        <input type="hidden" name="connectorRequestId" value="@request.ConnectorRequestId" />
                                                        <input type="hidden" name="targetHospitalId" value="@request.TransferRequest.TargetHospitalId" />
                                                        <button type="submit" class="btn btn-sm btn-success"
                                                                onclick="return confirm('Deliver this request?')">
                                                            <i class="bi bi-send-fill"></i> Deliver
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
