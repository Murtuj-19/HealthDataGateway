@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<style>
    .error-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .error-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        padding: 50px;
        max-width: 600px;
        text-align: center;
    }

    .error-icon {
        font-size: 5rem;
        color: #f5576c;
        margin-bottom: 20px;
        animation: bounceError 2s infinite;
    }

    @@keyframes bounceError {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }

    .error-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
    }

    .error-subtitle {
        font-size: 1.3rem;
        color: #666;
        margin-bottom: 30px;
    }

    .error-content {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 30px;
        text-align: left;
    }

    .error-content p {
        color: #555;
        line-height: 1.8;
        margin-bottom: 10px;
    }

    .error-content strong {
        color: #2c3e50;
    }

    .request-id {
        background: white;
        border: 2px solid #e0e0e0;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .request-id label {
        color: #666;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .request-id code {
        background: #f0f0f0;
        padding: 8px 12px;
        border-radius: 5px;
        color: #2c3e50;
        font-family: 'Courier New', monospace;
        word-break: break-all;
    }

    .btn-home {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 14px 40px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-home:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        color: white;
    }

    .dev-info {
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin-top: 30px;
        text-align: left;
    }

    .dev-info h4 {
        color: #856404;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .dev-info p {
        color: #856404;
        margin-bottom: 8px;
        line-height: 1.6;
    }
</style>

<div class="error-container">
    <div class="error-card">
        <div class="error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h1 class="error-title">Oops! Error Occurred</h1>
        <p class="error-subtitle">Something went wrong while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <div class="request-id">
                <label>Request ID:</label>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-content">
            <p>
                <strong><i class="bi bi-info-circle-fill"></i> What happened?</strong><br/>
                An unexpected error occurred while processing your request. Our team has been notified of this issue.
            </p>
            <p style="margin-top: 15px;">
                <strong><i class="bi bi-lightbulb-fill"></i> What can you do?</strong><br/>
                Please try refreshing the page or returning to the home page. If the problem persists, please contact our support team.
            </p>
        </div>

        <a href="/" class="btn-home">
            <i class="bi bi-house-fill"></i> Return to Home
        </a>

        @if (Model.ShowRequestId)
        {
            <div class="dev-info">
                <h4><i class="bi bi-code-slash"></i> Development Information</h4>
                <p>
                    You are seeing this detailed information because the application is running in <strong>Development</strong> mode.
                </p>
                <p>
                    <strong>Note:</strong> Do not enable Development mode in production environments as it may expose sensitive information.
                </p>
                <p style="margin-bottom: 0;">
                    To enable detailed error information locally, set the <code>ASPNETCORE_ENVIRONMENT</code> environment variable to <code>Development</code>.
                </p>
            </div>
        }
    </div>
</div>
