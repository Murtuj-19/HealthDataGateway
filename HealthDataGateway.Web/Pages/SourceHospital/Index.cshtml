@page
@model HealthDataGateway.Web.Pages.SourceHospital.IndexModel
@{
    ViewData["Title"] = "Source Hospital Dashboard";
}

<div class="container-fluid fade-in">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-white p-4">
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="bi bi-hospital-fill"></i> Source Hospital Dashboard
                    </h1>
                    <p class="lead mb-0">
                        <i class="bi bi-geo-alt-fill"></i> City General Hospital - Patient Management
                    </p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Total Patients</h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.Patients.Count</h2>
                        </div>
                        <i class="bi bi-people-fill opacity-50" style="font-size: 4rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Transfer Requests</h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.TransferRequests.Count</h2>
                        </div>
                        <i class="bi bi-arrow-right-circle-fill opacity-50" style="font-size: 4rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Pending</h6>
                            <h2 class="display-4 fw-bold mb-0">
                                @Model.TransferRequests.FindAll(t => t.Status == "CREATED" || t.Status == "QUEUED").Count
                            </h2>
                        </div>
                        <i class="bi bi-hourglass-split opacity-50" style="font-size: 4rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-lines-fill"></i> Patient Management
                    </h5>
                </div>
                <div class="card-body p-4">
                    <a asp-page="./CreatePatient" class="btn btn-success btn-lg w-100 mb-4 shadow">
                        <i class="bi bi-plus-circle-fill"></i> Register New Patient
                    </a>
                    
                    @if (Model.Patients.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
                            <p class="text-muted mt-3 fs-5">No patients registered yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Patient ID</th>
                                        <th>Name</th>
                                        <th>DOB</th>
                                        <th>Gender</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in Model.Patients)
                                    {
                                        <tr>
                                            <td><span class="badge bg-primary">@patient.LocalPatientId</span></td>
                                            <td class="fw-semibold">@patient.FullName</td>
                                            <td>
                                                @if (patient.DOB.HasValue)
                                                {
                                                    <span>@patient.DOB.Value.ToString("MMM dd, yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@patient.Gender</td>
                                            <td>
                                                <a asp-page="./CreateTransfer" asp-route-patientId="@patient.PatientId" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="bi bi-send-fill"></i> Transfer
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-arrow-right-circle-fill"></i> Transfer Requests
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.TransferRequests.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-send-x text-muted" style="font-size: 5rem;"></i>
                            <p class="text-muted mt-3 fs-5">No transfer requests yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Patient</th>
                                        <th>Target</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.TransferRequests)
                                    {
                                        <tr>
                                            <td><strong>#@request.TransferRequestId</strong></td>
                                            <td>@request.Patient.FullName</td>
                                            <td><small>@request.TargetHospital.HospitalName</small></td>
                                            <td>
                                                @if (request.Status == "SENT")
                                                {
                                                    <span class="badge bg-success">SENT</span>
                                                }
                                                else if (request.Status == "QUEUED")
                                                {
                                                    <span class="badge bg-warning">QUEUED</span>
                                                }
                                                else if (request.Status == "CREATED")
                                                {
                                                    <span class="badge bg-info">CREATED</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@request.Status</span>
                                                }
                                            </td>
                                            <td><small>@request.CreatedAt.ToString("MMM dd, HH:mm")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

