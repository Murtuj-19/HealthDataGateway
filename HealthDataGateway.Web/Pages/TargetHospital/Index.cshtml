@page
@model HealthDataGateway.Web.Pages.TargetHospital.IndexModel
@{
    ViewData["Title"] = "Target Hospital Dashboard";
}

<style>
    .stat-card-target {
        border-radius: 12px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .stat-card-target:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15) !important;
    }

    .status-badge-custom {
        padding: 8px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-pending {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .status-accepted {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

    .status-rejected {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        color: #333;
    }

    .btn-review {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: 20px;
        transition: all 0.3s ease;
    }

    .btn-review:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(79, 172, 254, 0.3);
        color: white;
    }

    .card-section {
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .card-section:hover {
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12) !important;
    }

    .hospital-badge {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .no-data-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        color: #999;
    }

    .no-data-empty i {
        font-size: 4rem;
        opacity: 0.4;
        margin-bottom: 15px;
    }

    .table-icon {
        margin-right: 8px;
    }
</style>

<div class="container-fluid fade-in">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="card-body text-white p-5">
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="bi bi-hospital-fill"></i> Target Hospital Dashboard
                    </h1>
                    <p class="lead mb-0">
                        <i class="bi bi-inbox-fill"></i> St. Mary's Medical Center - Review Incoming Transfer Requests
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" style="border: none; border-left: 4px solid #27ae60;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card stat-card-target border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75 mb-2">
                                <i class="bi bi-hourglass"></i> Pending
                            </h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.PendingCount</h2>
                        </div>
                        <i class="bi bi-clock-history opacity-50" style="font-size: 3.5rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card-target border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75 mb-2">
                                <i class="bi bi-check-circle"></i> Accepted
                            </h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.AcceptedCount</h2>
                        </div>
                        <i class="bi bi-check-circle-fill opacity-50" style="font-size: 3.5rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card-target border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase opacity-75 mb-2">
                                <i class="bi bi-x-circle"></i> Rejected
                            </h6>
                            <h2 class="display-4 fw-bold mb-0">@Model.RejectedCount</h2>
                        </div>
                        <i class="bi bi-x-circle-fill opacity-50" style="font-size: 3.5rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Incoming Requests Table -->
    <div class="row">
        <div class="col-12">
            <div class="card card-section border-0 shadow-lg">
                <div class="card-header text-white py-4" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-inbox-fill"></i> Incoming Transfer Requests
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.IncomingRequests.Count == 0)
                    {
                        <div class="no-data-empty">
                            <i class="bi bi-inbox"></i>
                            <p class="fs-5">No incoming requests</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="table-icon bi bi-hash"></i>Request ID</th>
                                        <th><i class="table-icon bi bi-person"></i>Patient Name</th>
                                        <th><i class="table-icon bi bi-building"></i>Source Hospital</th>
                                        <th><i class="table-icon bi bi-activity"></i>Status</th>
                                        <th><i class="table-icon bi bi-calendar"></i>Received At</th>
                                        <th><i class="table-icon bi bi-gear"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.IncomingRequests)
                                    {
                                        <tr>
                                            <td><strong>#@request.IncomingRequestId</strong></td>
                                            <td class="fw-semibold">
                                                @if (request.ConnectorRequest?.TransferRequest?.Patient != null)
                                                {
                                                    @request.ConnectorRequest.TransferRequest.Patient.FullName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="hospital-badge">
                                                    <i class="bi bi-building"></i> @request.SourceHospital.HospitalName
                                                </span>
                                            </td>
                                            <td>
                                                @if (request.IncomingStatus == "PENDING")
                                                {
                                                    <span class="status-badge-custom status-pending">
                                                        <i class="bi bi-hourglass-split"></i> PENDING
                                                    </span>
                                                }
                                                else if (request.IncomingStatus == "ACCEPTED")
                                                {
                                                    <span class="status-badge-custom status-accepted">
                                                        <i class="bi bi-check-circle-fill"></i> ACCEPTED
                                                    </span>
                                                }
                                                else if (request.IncomingStatus == "REJECTED")
                                                {
                                                    <span class="status-badge-custom status-rejected">
                                                        <i class="bi bi-x-circle-fill"></i> REJECTED
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">@request.ReceivedAt.ToString("MMM dd, yyyy HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <a asp-page="./ViewRequest" asp-route-id="@request.IncomingRequestId"
                                                   class="btn btn-sm btn-review">
                                                    <i class="bi bi-eye-fill"></i> Review
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>