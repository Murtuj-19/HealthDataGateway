@page
@model HealthDataGateway.Web.Pages.TargetHospital.ViewRequestModel
@{
    ViewData["Title"] = "Review Transfer Request";
}

<div class="container mt-4 fade-in">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            @if (Model.IncomingRequest != null)
            {
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header text-white py-4" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                        <h3 class="mb-1 fw-bold">
                            <i class="bi bi-file-earmark-medical-fill"></i> Transfer Request Review
                        </h3>
                        <p class="mb-0">Request ID: #@Model.IncomingRequest.IncomingRequestId</p>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="card bg-primary bg-opacity-10 border-primary h-100">
                                    <div class="card-body">
                                        <h5 class="fw-bold mb-3">Request Information</h5>
                                        <table class="table table-borderless">
                                            <tr>
                                                <td><strong>Request ID:</strong></td>
                                                <td>#@Model.IncomingRequest.IncomingRequestId</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Source Hospital:</strong></td>
                                                <td>@Model.IncomingRequest.SourceHospital.HospitalName</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Received At:</strong></td>
                                                <td>@Model.IncomingRequest.ReceivedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Status:</strong></td>
                                                <td>
                                                    @if (Model.IncomingRequest.IncomingStatus == "PENDING")
                                                    {
                                                        <span class="badge bg-warning">PENDING</span>
                                                    }
                                                    else if (Model.IncomingRequest.IncomingStatus == "ACCEPTED")
                                                    {
                                                        <span class="badge bg-success">ACCEPTED</span>
                                                    }
                                                    else if (Model.IncomingRequest.IncomingStatus == "REJECTED")
                                                    {
                                                        <span class="badge bg-danger">REJECTED</span>
                                                    }
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card bg-success bg-opacity-10 border-success h-100">
                                    <div class="card-body">
                                        <h5 class="fw-bold mb-3">Security Information</h5>
                                        <table class="table table-borderless">
                                            <tr>
                                                <td><strong>Encryption:</strong></td>
                                                <td>@Model.IncomingRequest.ConnectorRequest.EncryptionType</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Auth Type:</strong></td>
                                                <td>@Model.IncomingRequest.ConnectorRequest.AuthType</td>
                                            </tr>
                                            <tr>
                                                <td><strong>FHIR Compliant:</strong></td>
                                                <td>
                                                    @if (Model.IncomingRequest.ConnectorRequest.IsFHIRCompliant)
                                                    {
                                                        <span class="text-success">
                                                            <i class="bi bi-check-circle-fill"></i> Yes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">
                                                            <i class="bi bi-x-circle-fill"></i> No
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card bg-light mb-4">
                            <div class="card-header">
                                <h5 class="mb-0"><i class="bi bi-unlock"></i> Decrypted Patient Data</h5>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(Model.DecryptedData))
                                {
                                    <pre style="background: #f8f9fa; padding: 15px; border-radius: 5px;">@Model.DecryptedData</pre>
                                }
                                else
                                {
                                    <div class="alert alert-warning">Unable to decrypt patient data.</div>
                                }
                            </div>
                        </div>

                        @if (Model.IncomingRequest.IncomingStatus == "PENDING")
                        {
                            <form method="post">
                                <h5 class="mb-3">Your Decision</h5>

                                <div class="mb-3">
                                    <label class="form-label">Decision <span class="text-danger">*</span></label>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="Decision" id="acceptRadio" value="ACCEPTED" required>
                                        <label class="btn btn-outline-success" for="acceptRadio">
                                            <i class="bi bi-check-circle"></i> Accept Transfer
                                        </label>

                                        <input type="radio" class="btn-check" name="Decision" id="rejectRadio" value="REJECTED">
                                        <label class="btn btn-outline-danger" for="rejectRadio">
                                            <i class="bi bi-x-circle"></i> Reject Transfer
                                        </label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Remarks" class="form-label">Remarks (Optional)</label>
                                    <textarea asp-for="Remarks" class="form-control" rows="3"
                                              placeholder="Enter your remarks..."></textarea>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <a asp-page="./Index" class="btn btn-secondary">
                                        <i class="bi bi-arrow-left"></i> Back to Inbox
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save"></i> Submit Decision
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                This request has already been processed.
                            </div>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Inbox
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">Request not found.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}